# OS
.DS_Store
Thumbs.db
desktop.ini

# Sublime Text
*.sublime-workspace

# Build tools installed by `make tools`, and build output. `go build ./cmd/...` at the
# root writes /drawbridge; `make build` writes dist/drawbridge.
/bin/
/dist/
/drawbridge

# The docs site: `make docs` builds it into site/, from a virtualenv in .venv-docs. Zensical's own
# cache, .cache/, ignores itself.
/site/
/.venv-docs/

# `make web` copies the web app's build here; only the placeholder is tracked.
/internal/webui/dist/*
!/internal/webui/dist/.keep
